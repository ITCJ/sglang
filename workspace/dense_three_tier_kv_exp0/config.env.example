# Copy to config.env and replace every CHANGE_ME value.
EXP0_MODEL_PATH="CHANGE_ME"
EXP0_TOKENIZER_PATH="${EXP0_MODEL_PATH}"
EXP0_MODEL_REVISION="CHANGE_ME_MODEL_COMMIT"
EXP0_PYTHON="python3"

EXP0_SERVER_URL="http://127.0.0.1:30000"
EXP0_HOST="0.0.0.0"
EXP0_PORT="30000"
EXP0_API_KEY=""
EXP0_ADMIN_API_KEY=""

# Use 73728 for 64K. Use 139264 only for the optional 128K precheck.
EXP0_MAX_TOTAL_TOKENS="73728"
EXP0_HICACHE_SIZE_GB="20"
EXP0_MOONCAKE_CONFIG="CHANGE_ME/mooncake_worker.json"
EXP0_MOONCAKE_STORE_CONFIG="CHANGE_ME/mooncake_store.json"

# Add model/runtime-specific flags as Bash array elements. Fixed experiment
# flags (parallelism, KV dtype/capacities, HiCache, metrics, and auth) cannot
# be overridden here.
# DeepSeek-V3.1-w8a8 commonly needs --quantization modelslim.
EXP0_EXTRA_SERVER_ARGS=(--trust-remote-code --quantization modelslim)
